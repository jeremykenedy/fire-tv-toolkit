{
  "name": "fire-tv-toolkit-desktop",
  "productName": "Fire TV Toolkit",
  "version": "4.2.0",
  "description": "Manage Fire TV screensavers, home screens, Alexa and device settings from your desktop.",
  "author": "Jeremy Kenedy",
  "license": "MIT",
  "type": "module",
  "main": "main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:packaged": "node --test --test-timeout=120000 test/e2e/packaged.test.js",
    "lint": "eslint .",
    "prepare:adb": "node scripts/prepare-adb.js",
    "pack": "npm run prepare:adb && electron-builder --dir --publish never",
    "dist": "npm run prepare:adb && electron-builder --publish never",
    "dist:signed": "npm run prepare:adb && electron-builder --config electron-builder.signed.js --publish never"
  },
  "dependencies": {
    "fire-tv-toolkit": "file:..",
    "hls.js": "1.7.3"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.17.0",
    "eslint": "10.12.0",
    "fflate": "0.8.3",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "com.jeremykenedy.firetvtoolkit",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "controller.js",
      "iptv.js",
      "player-network.js",
      "tv-shell.js",
      "renderer/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/platform-tools",
        "to": "platform-tools"
      }
    ],
    "artifactName": "Fire-TV-Toolkit-${version}-${os}-${arch}.${ext}",
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Jeremy Kenedy <jeremykenedy@gmail.com>",
      "syncDesktopName": true
    }
  },
  "overrides": {
    "@electron/get": "5.1.0"
  },
  "homepage": "https://jeremykenedy.github.io/fire-tv-toolkit/",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeremykenedy/fire-tv-toolkit.git"
  },
  "desktopName": "com.jeremykenedy.firetvtoolkit"
}
